# Environment
.env
__pycache__/
*.pyc
.DS_Store

# Data directory (too large for GitHub — regenerate via scripts/update_data.py)
/data/

# Trained models — sub-model folders ignored, production model tracked in git
/models/GRU/
/models/LSTM/
/models/RF/
/models/XGBoost/
/models/scalers/

# Legacy notebooks (all logic migrated to src/)
/notebooks/

